+def normalize_clash_file(path: Path, meta_path: Path | None = None,
+                          warnings: list[str] | None = None) -> dict:
+    """规范化每日 Clash 文件，并同步修正其节点数和文件哈希元数据。"""
+    path = Path(path)
+    raw = path.read_bytes()
+    doc = yaml.safe_load(raw.decode("utf-8"))
+    if not isinstance(doc, dict):
+        raise ValueError(f"{path} 不是 Clash YAML 对象")
+    before = copy.deepcopy(doc)
+    normalize_clash_http_opts(doc, warnings)
+    changed = doc != before
+    output = raw
+    if changed:
+        output = yaml.dump(
+            doc, Dumper=ClashSafeDumper, allow_unicode=True, sort_keys=False,
+            default_flow_style=False, width=4096,
+        ).encode("utf-8")
+        atomic_write(path, output)
+    if meta_path is not None and Path(meta_path).exists():
+        meta_path = Path(meta_path)
+        try:
+            meta = json.loads(meta_path.read_text(encoding="utf-8"))
+        except (json.JSONDecodeError, UnicodeDecodeError):
+            meta = {}
+            if warnings is not None:
+                warnings.append("meta.json 无法解析，已重建校验字段")
+        if not isinstance(meta, dict):
+            meta = {}
+            if warnings is not None:
+                warnings.append("meta.json 根结构无效，已重建")
+        for name in ("nodes", "sha256_16", "source_sha256_16"):
+            if not isinstance(meta.get(name), dict):
+                meta[name] = {}
+                if warnings is not None:
+                    warnings.append(f"meta.json 的 {name} 结构无效，已重建")
+        nodes = meta["nodes"]
+        hashes = meta["sha256_16"]
+        source_hashes = meta["source_sha256_16"]
+        source_hashes["clash"] = hashlib.sha256(raw).hexdigest()[:16]
+        hashes["clash"] = hashlib.sha256(output).hexdigest()[:16]
+        nodes["clash"] = len(doc.get("proxies") or [])
+        meta["clash_normalization"] = {
+            "http_opts_headers": "scalar_values_to_lists", "changed": changed,
+        }
+        atomic_write(meta_path, json.dumps(meta, ensure_ascii=False, indent=2).encode("utf-8"))
+    return doc
 
 
