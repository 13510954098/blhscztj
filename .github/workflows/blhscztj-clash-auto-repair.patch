+    def test_daily_clash_normalizer_repairs_headers_and_metadata(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            clash_path = root / "clash.yaml"
+            meta_path = root / "meta.json"
+            clash_path.write_text(
+                "proxies:\n- type: vmess\n  server: edge.example\n  port: 443\n"
+                "  name: edge\n  network: http\n  http-opts:\n    headers:\n"
+                "      Host: edge.example\n",
+                encoding="utf-8",
+            )
+            meta_path.write_text(json.dumps({
+                "nodes": {"clash": 0}, "sha256_16": {"clash": "old"},
+            }), encoding="utf-8")
+            doc = merge.normalize_clash_file(clash_path, meta_path)
+            meta = json.loads(meta_path.read_text(encoding="utf-8"))
+            self.assertEqual(doc["proxies"][0]["http-opts"]["headers"]["Host"], ["edge.example"])
+            self.assertEqual(meta["nodes"]["clash"], 1)
+            self.assertTrue(meta["clash_normalization"]["changed"])
+            self.assertIn("clash", meta["source_sha256_16"])
+            self.assertNotEqual(meta["sha256_16"]["clash"], "old")
