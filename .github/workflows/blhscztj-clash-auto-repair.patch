+
+    def test_clash_count_ignores_comments_and_reports_invalid_schema(self):
+        self.assertEqual(fetch_jcnode.count_clash("proxies: []\n"), 0)
+        self.assertEqual(fetch_jcnode.count_clash("proxies: 7\n"), 0)
+        self.assertEqual(fetch_jcnode.count_clash("proxies:\n  type: vmess\n  server: x\n"), 1)
+        with self.assertRaisesRegex(ValueError, "合法 YAML"):
+            fetch_jcnode.count_clash("proxies: [\n")
